# Copy: cp .env.example .env   (.env nằm trong .gitignore — KHÔNG commit)
# Không ghi secret thật vào file này.

PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret: đặt giá trị thật trong .env (local) hoặc biến môi trường của platform
AGENT_API_KEY=change-me

# docker compose tự ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
